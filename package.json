{
  "name": "dsh-purge",
  "version": "1.6.4",
  "description": "DeepSeek Harness 破甲：让所有模型都能破甲，不同模型可换不同提示词；默认提示词面向国模「小码酱」。Jailbreak for every model — swap prompts per model. 求 Star 收藏 ⭐ 如要二开，请查看署名要求部分",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./client.js",
    "./redteam": "./lib/redteam/index.js",
    "./redteam/store": "./lib/redteam/store.js",
    "./redteam/ui": "./lib/redteam/ui.js",
    "./redteam/tools": "./lib/redteam/tools.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-purge": "bin/dsh-purge.js"
  },
  "files": [
    "lib",
    "!lib/default-prompt-inject.md",
    "bin",
    "docs",
    "presets",
    "skills",
    "scripts",
    "client.js",
    "cordis.patch.yml",
    "screenshots.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "NOTICE.md",
    "DISCLAIMER.md",
    "CHANGELOG.md",
    "test/"
  ],
  "scripts": {
    "verify-agent-note-tree": "node .agents/skills/agent-notes/scripts/verify-agent-note-tree.ts",
    "verify-agent-note-format": "node .agents/skills/agent-notes/scripts/verify-agent-note-format.ts",
    "verify-archived": "node .agents/skills/agent-notes/scripts/verify-archived-agent-notes.ts",
    "verify-notes": "npm run verify-agent-note-tree && npm run verify-agent-note-format && npm run verify-archived",
    "archive-agent-note": "node .agents/skills/agent-notes/scripts/archive-agent-note.ts",
    "check-anchors": "node .agents/skills/agent-notes/scripts/check-note-anchors.ts",
    "init-board": "node .agents/skills/agent-notes/scripts/build-board.ts --init board.html \"工程决策看板\"",
    "embed-prompt": "node scripts/embed-default-prompt.mjs",
    "build:client": "node scripts/build-client.mjs",
    "test:gate": "node test/gate.mjs",
    "test:cwd": "node test/cwd-variable.mjs",
    "test:tauri": "node test/tauri-host.mjs",
    "test:critical": "node test/critical-alert.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "网络安全",
    "红队评测",
    "llm-security",
    "harness-security",
    "deepseek-harness",
    "red-team",
    "instructions",
    "rules",
    "prompt-eval",
    "agent",
    "jailbreak",
    "armor",
    "prompt-hardening"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iuuuuuuuu/dsh-purge-plus.git"
  },
  "homepage": "https://github.com/iuuuuuuuu/dsh-purge-plus#readme",
  "bugs": {
    "url": "https://github.com/iuuuuuuuu/dsh-purge-plus/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "install": {
      "preferred": "tarball",
      "tarball": "https://github.com/iuuuuuuuu/dsh-purge-plus/archive/refs/heads/main.tar.gz",
      "zip": "https://github.com/iuuuuuuuu/dsh-purge-plus/archive/refs/heads/main.zip",
      "git": "https://github.com/iuuuuuuuu/dsh-purge-plus.git"
    },
    "version": "1.6.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  },
  "dshTarget": "0.2.2-rc.3"
}
